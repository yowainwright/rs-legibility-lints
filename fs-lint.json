{
  "version": 1,
  "newFiles": {
    "default": "deny",
    "allow": [
      ".cargo/config.toml",
      ".github/CODEOWNERS",
      ".github/**/*.md",
      ".github/**/*.yml",
      ".gitignore",
      "Cargo.toml",
      "Cargo.lock",
      "LICENSE",
      "Makefile",
      "README.md",
      "fs-lint.json",
      "rust-toolchain.toml",
      ".editorconfig",
      "clippy.toml",
      "dylint.toml",
      "rustfmt.toml",
      "scripts/hooks.sh",
      "scripts/package-release.sh",
      "tests/scripts/hooks.sh",
      "src/**/*.{rs,stderr,fixed}",
      "tests/lints.rs",
      "tests/fixtures/**/*.{rs,stderr,fixed}"
    ]
  }
}
